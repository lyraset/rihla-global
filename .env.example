# Copy to .env.local and fill in. .env.local is gitignored.
# Only MONGODB_URI is required to run the lead-capture backend locally;
# every integration below degrades gracefully when its keys are absent.

# ---- Core ----
# In production set this to your real domain (used for canonical/OG links, e.g.
# https://rihla-global.vercel.app). Leave as localhost only for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ---- MongoDB (REQUIRED for persistence) ----
# Atlas: create an M0 cluster, a DB user with readWrite on `rihla`, allow 0.0.0.0/0.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rihla?retryWrites=true&w=majority
MONGODB_DB=rihla

# ---- Cloudinary (media pipeline; get from cloudinary.com dashboard) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=rihla
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- Auth (Auth.js) ----
# AUTH_SECRET is a JWT signing key (NOT a login credential). Required in prod.
AUTH_SECRET=              # openssl rand -base64 32
# Do NOT set AUTH_URL in production. trustHost:true auto-detects the deployed
# domain (Vercel provides it). A hardcoded AUTH_URL=localhost is what makes
# /admin redirect to localhost after login — leave it unset everywhere but
# unusual reverse-proxy setups.
# AUTH_URL=
# Admin accounts live in the database — create the first one at /admin on first run,
# or with: npm run create-admin -- <email> <password>

# ---- WhatsApp (number 0324-3799558 → E.164 923243799558) ----
WHATSAPP_BUSINESS_NUMBER=923243799558
NEXT_PUBLIC_WHATSAPP_NUMBER=923243799558
WHATSAPP_MODE=link                             # 'link' (default) | 'cloud_api'
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_TEMPLATE_NAME=new_lead_alert
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Email (Resend — verify sending domain for auto-replies) ----
RESEND_API_KEY=
LEAD_NOTIFY_TO=           # where new-lead alerts are sent
LEAD_NOTIFY_FROM=noreply@rihlaglobal.com

# ---- Anti-spam (Cloudflare Turnstile — optional; skipped if unset) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Rate limiting (Upstash Redis — optional; falls back to a Mongo TTL limiter) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Ops ----
REVALIDATE_SECRET=        # also used to sign newsletter unsubscribe links
CRON_SECRET=
